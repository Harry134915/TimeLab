<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ModernTaskCheckBoxStyle"
           TargetType="CheckBox">

        <!-- 基础属性 -->

        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="CheckBox">

                    <Grid Width="26"
                          Height="26">

                        <!-- 主圆 -->

                        <Border x:Name="Circle"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                BorderThickness="2"
                                BorderBrush="#B8B8B8"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">

                            <!-- Circle 缩放 -->

                            <Border.RenderTransform>

                                <ScaleTransform x:Name="ScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1"/>

                            </Border.RenderTransform>

                            <Grid>

                                <!-- 勾 -->

                                <Path x:Name="CheckMark"
                                      Data="M 4 10 L 8 14 L 15 5"
                                      Stroke="White"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Opacity="0"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">

                                    <!-- 勾缩放 -->

                                    <Path.RenderTransform>

                                        <ScaleTransform x:Name="CheckMarkScale"
                                                        ScaleX="0.6"
                                                        ScaleY="0.6"/>

                                    </Path.RenderTransform>

                                </Path>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- 动画资源 -->

                    <ControlTemplate.Resources>

                        <!-- Hover 放大 -->

                        <Storyboard x:Key="HoverEnterAnimation">

                            <DoubleAnimation
                                Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="1.08"
                                Duration="0:0:0.12">

                                <DoubleAnimation.EasingFunction>

                                    <CubicEase EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                            <DoubleAnimation
                                Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="1.08"
                                Duration="0:0:0.12">

                                <DoubleAnimation.EasingFunction>

                                    <CubicEase EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                        </Storyboard>

                        <!-- Hover 恢复 -->

                        <Storyboard x:Key="HoverLeaveAnimation">

                            <DoubleAnimation
                                Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="0:0:0.12">

                                <DoubleAnimation.EasingFunction>

                                    <CubicEase EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                            <DoubleAnimation
                                Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.12">

                                <DoubleAnimation.EasingFunction>

                                    <CubicEase EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                        </Storyboard>

                        <!-- 勾选动画 -->

                        <Storyboard x:Key="CheckedAnimation">

                            <!-- Circle 弹一下 -->

                            <DoubleAnimation
                                Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleX"
                                From="1"
                                To="1.12"
                                Duration="0:0:0.10"
                                AutoReverse="True">

                                <DoubleAnimation.EasingFunction>

                                    <BackEase Amplitude="0.35"
                                              EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                            <DoubleAnimation
                                Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleY"
                                From="1"
                                To="1.12"
                                Duration="0:0:0.10"
                                AutoReverse="True">

                                <DoubleAnimation.EasingFunction>

                                    <BackEase Amplitude="0.35"
                                              EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                            <!-- 勾淡入 -->

                            <DoubleAnimation
                                Storyboard.TargetName="CheckMark"
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="0:0:0.12"/>

                            <!-- 勾缩放 -->

                            <DoubleAnimation
                                Storyboard.TargetName="CheckMarkScale"
                                Storyboard.TargetProperty="ScaleX"
                                From="0.6"
                                To="1"
                                Duration="0:0:0.14">

                                <DoubleAnimation.EasingFunction>

                                    <BackEase Amplitude="0.4"
                                              EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                            <DoubleAnimation
                                Storyboard.TargetName="CheckMarkScale"
                                Storyboard.TargetProperty="ScaleY"
                                From="0.6"
                                To="1"
                                Duration="0:0:0.14">

                                <DoubleAnimation.EasingFunction>

                                    <BackEase Amplitude="0.4"
                                              EasingMode="EaseOut"/>

                                </DoubleAnimation.EasingFunction>

                            </DoubleAnimation>

                        </Storyboard>

                    </ControlTemplate.Resources>

                    <!-- Trigger -->

                    <ControlTemplate.Triggers>

                        <!-- Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Circle"
                                    Property="BorderBrush"
                                    Value="#22C55E"/>

                            <Setter TargetName="Circle"
                                    Property="Background"
                                    Value="#1122C55E"/>

                        </Trigger>

                        <!-- Checked -->

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter TargetName="Circle"
                                    Property="Background"
                                    Value="#22C55E"/>

                            <Setter TargetName="Circle"
                                    Property="BorderBrush"
                                    Value="#22C55E"/>

                        </Trigger>

                        <!-- Disabled -->

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter Property="Opacity"
                                    Value="0.45"/>

                        </Trigger>

                        <!-- Hover 进入动画 -->

                        <EventTrigger RoutedEvent="MouseEnter">

                            <BeginStoryboard
                                Storyboard="{StaticResource HoverEnterAnimation}"/>

                        </EventTrigger>

                        <!-- Hover 离开动画 -->

                        <EventTrigger RoutedEvent="MouseLeave">

                            <BeginStoryboard
                                Storyboard="{StaticResource HoverLeaveAnimation}"/>

                        </EventTrigger>

                        <!-- 勾选动画 -->

                        <EventTrigger RoutedEvent="CheckBox.Checked">

                            <BeginStoryboard
                                Storyboard="{StaticResource CheckedAnimation}"/>

                        </EventTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>