<Window x:Class="TimeLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeLab.App"
        mc:Ignorable="d"
        Title="番茄钟" Height="640" Width="1000"
        MinHeight="480" MinWidth="640"
        Icon="/Assets/Idol.jpg"
        Background="#F0F2F5"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackToWorkspaceCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <local:TaskIdToTitleConverter x:Key="TaskIdConverter"/>
        <local:DurationConverter x:Key="DurationConverter"/>
        <local:SecondsConverter x:Key="SecondsConverter"/>

        <!-- 颜色已迁移至 App.xaml -->

        <Style x:Key="AccessibleFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="2" CornerRadius="7" Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 基础按钮（圆角模板） -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主要按钮：蓝底白字 -->
        <Style x:Key="PrimaryButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
        </Style>

        <!-- 次要按钮：浅灰底边框 -->
        <Style x:Key="SecondaryButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- 停止按钮：暖色底 -->
        <Style x:Key="StopButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StopBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StopBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
        </Style>

        <!-- 文字按钮：纯文字无背景 -->
        <Style x:Key="LinkButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- 危险文字按钮：红色文字 -->
        <Style x:Key="DangerTextButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SessionLogEntryButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="DangerOutlineButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource DangerTextBrush}"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsHitTestVisible="False" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Margin="8,4,0,4"
                                               Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Path Grid.Column="1" Data="M0,0 L3,3 L6,0"
                                          Stroke="{DynamicResource MutedBrush}"
                                          StrokeThickness="1.5" Fill="Transparent"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- 列表项 -->
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="8,6" Margin="0,1">
                            <ContentPresenter TextElement.Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TimerPanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid>
        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="TimeLab 工作区">
        <Grid Margin="14" MinWidth="860" MinHeight="540">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="430"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="4*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：任务列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}"
                    DataContext="{Binding TaskList}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource SuccessBrush}"
                            VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                        <TextBlock Text="任务列表" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="任务名称" Padding="0,0,0,4"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Target="{Binding ElementName=NewTaskTitleBox}"/>
                        <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="计划时长（可选）"
                               Padding="0,0,0,4" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Target="{Binding ElementName=NewTaskDurationBox}"/>

                        <TextBox x:Name="NewTaskTitleBox" Grid.Row="1" Grid.Column="0"
                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="任务名称"
                             VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBox x:Name="NewTaskDurationBox" Grid.Row="1" Grid.Column="1"
                             Text="{Binding NewTaskDuration, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="计划时长"
                             Width="64" VerticalAlignment="Center" Margin="0,0,4,0"
                             FontSize="12" Padding="6,6"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding DurationUnits}"
                               SelectedIndex="{Binding DurationUnitIndex}"
                               AutomationProperties.Name="计划时长单位"
                               Width="72" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="12"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="添加" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddTaskCommand}"
                            AutomationProperties.HelpText="添加任务，计划时长可以留空"/>

                        <TextBlock x:Name="TaskDurationErrorText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding NewTaskDurationError}"
                                   Foreground="{DynamicResource DangerTextBrush}" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="还没有任务" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="在上方添加任务，开始一次专注"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <ListView ItemsSource="{Binding Tasks}" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                           Style="{StaticResource ModernTaskCheckBoxStyle}"
                                           FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding Title, StringFormat=完成任务：{0}}"
                                           Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding Id}"/>

                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                             Background="{DynamicResource WarningSurfaceBrush}" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlannedSeconds}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock VerticalAlignment="Center" FontSize="10"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   Text="{Binding PlannedSeconds, Converter={StaticResource SecondsConverter}}"/>
                                            </Border>
                                        </Grid>

                                        <Button Grid.Column="2" Content="关联"
                                        Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding Id}"
                                        AutomationProperties.Name="{Binding Title, StringFormat=关联计时：{0}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="3" Content="删除"
                                        Style="{StaticResource DangerTextButtonStyle}"
                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding Id}"
                                        AutomationProperties.Name="{Binding Title, StringFormat=删除任务：{0}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Focusable="True" AutomationProperties.Name="调整任务与计时区域宽度"/>

            <!-- 右侧：番茄钟；打开记录时扩展为独立页面 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSessionLogViewVisible}" Value="True">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 番茄钟卡片 -->
                <Border Grid.Row="0" Margin="0,0,0,12" DataContext="{Binding Timer}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSessionLogViewVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 标题栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" CornerRadius="2" Background="{DynamicResource StopBrush}"
                                        VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                                <TextBlock Text="番茄钟" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SessionLogEntryButtonStyle}"
                                        Command="{Binding DataContext.ShowSessionLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="打开专注记录"
                                        FontSize="11" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M8,1 A7,7 0 1 0 15,8 M8,4 L8,8 L11,10"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Margin="0,0,7,0"/>
                                        <TextBlock Text="专注记录" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsDarkMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Style="{StaticResource GorgeousSwitch}"
                                          FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                          AutomationProperties.Name="切换深色模式"
                                          AutomationProperties.HelpText="在浅色和深色主题之间切换"
                                          FontSize="11" Padding="4,2"/>
                            </StackPanel>
                        </Grid>

                        <!-- 计时主体：先突出当前状态与时间 -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="运行中">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="已暂停">
                                                <Setter Property="Background" Value="{DynamicResource WarningTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="已停止">
                                                <Setter Property="Background" Value="{DynamicResource StopBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock x:Name="TimerStatusText" Text="{Binding StatusText}" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="运行中">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="已暂停">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="已停止">
                                                <Setter Property="Foreground" Value="{DynamicResource StopTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ModeName, StringFormat= · {0}}"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding CompletedFocusCount, StringFormat= · 已完成 {0} 轮}"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompletedFocusCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding TimerDisplayLabel}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ElapsedDisplay}" FontSize="46"
                                       FontFamily="Segoe UI" FontWeight="Light"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.Name="{Binding ElapsedDisplay, StringFormat=计时器：{0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTargetReached}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding TimerTargetSummary}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,-2,0,4"/>

                            <TextBlock Text="{Binding CycleProgress}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCycleActive}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="关联：" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Text="{Binding DataContext.TaskList.SelectedTaskTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                                       Margin="4,0" FontSize="11" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Content="清除关联"
                                    Command="{Binding DataContext.TaskList.ClearSelectedTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.Name="清除计时器关联任务"
                                    FontSize="11" Padding="6,2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.TaskList.SelectedTaskId, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- 主操作区 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartTimerCommand}"
                                AutomationProperties.HelpText="开始计时，暂停后可继续"
                                Width="84" Height="36" Margin="0,0,8,0"/>
                            <Button Content="暂停" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PauseTimerCommand}"
                                Width="64" Height="36" Margin="0,0,8,0"/>
                            <Button Content="停止" Style="{StaticResource StopButtonStyle}"
                                Command="{Binding StopTimerCommand}"
                                Width="64" Height="36" Margin="0,0,4,0"/>
                            <Button Content="重置" Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding ResetTimerCommand}"
                                AutomationProperties.HelpText="清除已停止或已完成的计时状态"
                                Width="52" Height="36"/>
                        </StackPanel>

                        <Border Grid.Row="3" Height="1" Background="{DynamicResource CardBorderBrush}"
                                Margin="0,12,0,10"/>

                        <!-- 次要设置区 -->
                        <StackPanel Grid.Row="4" IsEnabled="{Binding CanEditTimerSetup}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCycleActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="快速开始" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding PresetMinutes}"
                                              HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" ContentStringFormat="{}{0} 分"
                                                    Command="{Binding DataContext.StartPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding StringFormat=快速计时 {0} 分钟}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="10" MinWidth="42" Padding="5,3" Margin="0,0,4,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="循环设置" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="专注" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,3,0"/>
                                    <TextBox Text="{Binding CycleFocusMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="循环专注分钟"
                                             Width="38" FontSize="10" Padding="3"
                                             VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="休息" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,3,0"/>
                                    <TextBox Text="{Binding CycleBreakMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="循环休息分钟"
                                             Width="38" FontSize="10" Padding="3"
                                             VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="轮数" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,3,0"/>
                                    <TextBox Text="{Binding CycleTotalRoundsText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="循环轮数"
                                             Width="38" FontSize="10" Padding="3"
                                             VerticalAlignment="Center" TextAlignment="Center"/>
                                </WrapPanel>
                                <Button Grid.Column="2" Content="开始循环" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding StartCycleCommand}"
                                        FontSize="10" MinWidth="70" Padding="6,3" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock x:Name="CycleValidationText" Text="{Binding CycleValidationMessage}"
                                       Foreground="{DynamicResource DangerTextBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="62,5,0,0"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleValidationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 独立专注记录页面 -->
                <Border Grid.Row="1" DataContext="{Binding SessionLog}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSessionLogViewVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="48"/>
                        </Grid.RowDefinitions>

                        <!-- 标题栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.BackToWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="返回任务与计时页面"
                                        Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M8,1 L1,8 L8,15 M1,8 H15"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Margin="0,0,7,0"/>
                                        <TextBlock Text="返回" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="3" CornerRadius="2" Background="{DynamicResource PrimaryBrush}"
                                    VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="专注记录" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="回顾每一次投入的时间" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DangerOutlineButtonStyle}"
                                        Command="{Binding ClearSessionsCommand}"
                                        AutomationProperties.Name="清空全部专注记录"
                                        AutomationProperties.HelpText="删除全部专注记录，需要再次确认">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M2,4 H14 M6,4 V2 H10 V4 M4,4 L5,14 H11 L12,4 M7,7 V11 M9,7 V11"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource DangerTextBrush}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Margin="0,0,7,0"/>
                                        <TextBlock Text="清空全部" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Panel.ZIndex="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="还没有专注记录" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="完成一次专注后，记录会显示在这里"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView Grid.Column="0" ItemsSource="{Binding Sessions}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="RecordCard"
                                                            Background="{DynamicResource CardBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="14,10">
                                                        <ContentPresenter TextElement.Foreground="{DynamicResource TextBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RecordCard" Property="Background" Value="{DynamicResource TimerPanelBrush}"/>
                                                            <Setter TargetName="RecordCard" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RecordCard" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/>
                                                            <Setter TargetName="RecordCard" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,12,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mode}" Value="ShortBreak">
                                                                <Setter Property="Background" Value="{DynamicResource WarningTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Mode}" Value="LongBreak">
                                                                <Setter Property="Background" Value="{DynamicResource StopBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Mode}" Value="ShortBreak">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Mode}" Value="LongBreak">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Setter Property="Text" Value="专注"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mode}" Value="ShortBreak">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                                            <Setter Property="Text" Value="短休"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Mode}" Value="LongBreak">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StopTextBrush}"/>
                                                                            <Setter Property="Text" Value="长休"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TaskId}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentTextBrush}"
                                                                   MaxWidth="150" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource TaskIdConverter}">
                                                                    <Binding Path="TaskId"/>
                                                                    <Binding Path="DataContext.TaskList.Tasks" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    <Binding Path="DataContext.TaskList.Tasks.Count" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:HH:mm:ss} → {1:HH:mm:ss}">
                                                            <Binding Path="StartTime"/>
                                                            <Binding Path="EndTime"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="删除"
                                            Style="{StaticResource DangerTextButtonStyle}"
                                            Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding Id}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding StartTime, StringFormat=删除 {0:HH:mm} 的专注记录}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 今日概览侧栏 -->
                            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                                <Border Background="{DynamicResource TimerPanelBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="今日概览" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="只统计今天的专注成果" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,14"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding TodayFocusCount}" FontSize="32"
                                                       FontFamily="Segoe UI" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock Text=" 次专注" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Bottom" Margin="3,0,0,6"/>
                                        </StackPanel>

                                        <Border Height="1" Background="{DynamicResource CardBorderBrush}"
                                                Margin="0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TodayFocusMinutes}" FontSize="20"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="专注分钟" FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TodayCompletedTaskCount}" FontSize="20"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="完成任务" FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="9"
                                        Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="记录类型" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="专注" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text=" · 投入时间" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{DynamicResource WarningTextBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="短休" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text=" · 短暂恢复" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{DynamicResource StopBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="长休" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text=" · 深度恢复" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <!-- 通知条 -->
        <Border CornerRadius="6" Panel.ZIndex="10"
                Padding="14,10" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,10,0,0"
                MaxWidth="560">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessFillBrush}"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotificationVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsErrorNotification}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="NotificationText" Text="{Binding NotificationMessage}" FontSize="14"
                       Foreground="{DynamicResource ButtonForegroundBrush}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center"
                       AutomationProperties.LiveSetting="Assertive"/>
        </Border>
    </Grid>
</Window>
