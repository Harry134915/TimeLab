<Application x:Class="TimeLab.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TimeLab.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/GorgeousSwitch.xaml"/>
                <ResourceDictionary Source="/Styles/ModernTaskCheckBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#3659D9"/>
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2948BD"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#2F50C8"/>
            <SolidColorBrush x:Key="StopBrush" Color="#B5472D"/>
            <SolidColorBrush x:Key="StopTextBrush" Color="#9E3B28"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#126B3E"/>
            <SolidColorBrush x:Key="SuccessFillBrush" Color="#126B3E"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
            <SolidColorBrush x:Key="DangerTextBrush" Color="#A61B13"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#8F1710"/>
            <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5A00"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#2D3436"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#5F6B76"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#84909C"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D7DCE2"/>
            <SolidColorBrush x:Key="TimerPanelBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="FocusBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#EDF9F2"/>
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFF1F0"/>
            <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF6DF"/>
            <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#EEF1FE"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
